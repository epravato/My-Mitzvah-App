{
  "expo": {
    "name": "Tefillin Challenge",
    "slug": "tefillin-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tefillinchallenge",
    "splash": {
      "backgroundColor": "#F4F6FA",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethanpravato.tefillinchallenge",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo to log the mitzvah you did today.",
        "NSPhotoLibraryUsageDescription": "Choose a photo to log the mitzvah you did today."
      }
    },
    "android": {
      "package": "com.ethanpravato.tefillinchallenge",
      "adaptiveIcon": {
        "backgroundColor": "#E3EDFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to log the mitzvah you did today.",
          "cameraPermission": "Take a photo to log the mitzvah you did today."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6d8d98ed-a75e-4a89-8de2-5743c51ec11f"
      }
    },
    "owner": "epravato",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6d8d98ed-a75e-4a89-8de2-5743c51ec11f"
    }
  }
}
