# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Cloudflare Workers local dev cache (backend/)
.wrangler/

# D1 database dumps taken before migrations. These are full exports of the live
# database, including password hashes and session rows, so they must never be
# committed — not even to a private repo.
backend/backups/

